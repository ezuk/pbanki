#!/usr/bin/env python3
"""Fake `claude`, printing what `claude -p --output-format json` prints. See _fake.py."""

import json
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

import _fake  # noqa: E402

if "--version" in sys.argv:
    print(os.environ.get("FAKE_AI_VERSION", "2.1.317 (Claude Code)"))
    sys.exit(0)

system = sys.argv[sys.argv.index("--system-prompt") + 1] if "--system-prompt" in sys.argv else ""
user = sys.stdin.read()
prompt = system + "\n\n" + user
_fake.log_run("claude", user)
mode = _fake.mode_for(prompt)
_fake.hold_when_slow(mode)


def result(text, is_error=False):
    print(json.dumps({"type": "result", "subtype": "error" if is_error else "success",
                      "is_error": is_error, "result": text, "session_id": "fake"}))


if mode == "is_error":
    result("API Error: the fake model is overloaded", is_error=True)
    sys.exit(1)
if mode == "not_logged_in":
    result("Not logged in · Please run /login", is_error=True)
    sys.exit(1)
if mode == "exit":
    print("fake claude went wrong", file=sys.stderr)
    sys.exit(3)
if mode == "no_output":
    sys.exit(0)
result(_fake.answer_text(prompt, mode))
