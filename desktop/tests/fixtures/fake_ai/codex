#!/usr/bin/env python3
"""Fake `codex exec`, writing its answer to the -o file. See _fake.py."""

import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

import _fake  # noqa: E402

if "--version" in sys.argv:
    print(os.environ.get("FAKE_AI_VERSION", "codex-cli 0.160.1"))
    sys.exit(0)

prompt = sys.stdin.read()
_fake.log_run("codex", prompt)
mode = _fake.mode_for(prompt)
_fake.hold_when_slow(mode)

if mode == "is_error":
    print("ERROR: the fake model is overloaded", file=sys.stderr)
    sys.exit(1)
if mode == "not_logged_in":
    print("Not logged in. Run codex login first.", file=sys.stderr)
    sys.exit(1)
if mode == "exit":
    print("fake codex went wrong", file=sys.stderr)
    sys.exit(3)
if mode == "no_output":
    sys.exit(0)
with open(sys.argv[sys.argv.index("-o") + 1], "w", encoding="utf-8") as f:
    f.write(_fake.answer_text(prompt, mode))
