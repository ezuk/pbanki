import "fonts/JetBrainsMono-Regular.ttf";
import "fonts/JetBrainsMono-Bold.ttf";
import "fonts/JetBrainsMono-Italic.ttf";
import "fonts/JetBrainsMono-BoldItalic.ttf";

import { Constants } from "constants.slint";

export { Constants }
import { DeckNode, DeckTree, CardNode, LoginState, EditSide } from "types.slint";
import { LearnScreen } from "screens/learn.slint";
import { DeckSelectScreen } from "screens/deck_select.slint";
import { SettingsScreen } from "screens/settings.slint";
import { EditScreen } from "screens/edit.slint";

export component MainWindow inherits Window {
    // PocketBook Verse screen in logical pixels (758x1024 at 3x)
    preferred-width: 252.67px;
    preferred-height: 341.33px;
    default-font-family: Constants.font_family;
    background: Constants.paper;

    in property <string> error_message;

    in-out property <bool> learning;
    in-out property <CardNode> current_card;
    in-out property <DeckTree> deck_tree;

    // Edit screen over the study screen; sides are filled in by edit_card
    in-out property <bool> editing;
    in-out property <int> edit_side;
    in property <[EditSide]> edit_sides;
    in property <string> edit_error;

    // Settings screen; values are filled in by open_settings
    in property <bool> native_keyboard;
    in-out property <bool> showing_settings;
    in-out property <string> settings_username;
    in-out property <string> settings_password;
    in-out property <int> settings_font_size;
    in property <LoginState> settings_login_state;
    in property <string> settings_login_message;
    in-out property <bool> settings_sync_on_startup;
    in property <bool> settings_limits_available;
    in-out property <int> settings_new_per_day;
    in-out property <int> settings_reviews_per_day;

    // AnkiWeb sync status on the deck list
    in-out property <bool> syncing;
    in property <string> sync_message;
    in property <bool> sync_failed;
    // AnkiWeb asks which collection to keep
    in property <bool> sync_choice;
    in property <bool> sync_upload_ok;
    in property <bool> sync_download_ok;
    // "download" or "upload" while asking to confirm
    in-out property <string> sync_confirm;

    // Text grid available to a card page; must match LearnScreen's layout
    property <length> content-width: root.width - 2 * Constants.padding;
    property <length> content-height: root.height - 2 * Constants.padding - Constants.top_bar_height - 2 * Constants.border - Constants.nav_height - Constants.button_bar_height - 4 * Constants.spacing;
    property <int> columns: Math.floor(content-width / Constants.char_width);
    property <int> rows: Math.floor(content-height / Constants.line_height);

    callback update_deck_tree();
    callback toggle_deck(deck: DeckNode);
    callback deck_clicked(deck: DeckNode, columns: int, rows: int);
    callback rate(rating: int, deck: DeckNode, columns: int, rows: int);
    callback undo(deck: DeckNode, columns: int, rows: int) -> bool;
    callback suspend(deck: DeckNode, columns: int, rows: int);
    callback edit_card();
    callback edit_text(side: int);
    callback edit_typed(side: int, text: string);
    callback save_edit(deck: DeckNode, columns: int, rows: int);
    callback open_settings();
    callback request_text(field: string);
    callback credentials_edited();
    callback validate_login();
    callback save_settings();
    callback sync();
    callback full_sync(upload: bool);
    callback dismiss_sync();

    VerticalLayout {
        padding: Constants.padding;

        if error_message != "": VerticalLayout {
            alignment: center;
            spacing: Constants.spacing;
            Text {
                text: "pbAnki";
                font-size: Constants.font_size_heading;
                font-weight: 800;
                horizontal-alignment: center;
            }
            Text {
                text: error_message;
                font-size: Constants.font_size_content;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
        }

        if error_message == "" && showing_settings: SettingsScreen {
            native_keyboard: native_keyboard;
            username <=> settings_username;
            password <=> settings_password;
            font_size <=> settings_font_size;
            sync_on_startup <=> settings_sync_on_startup;
            limits_available: settings_limits_available;
            new_per_day <=> settings_new_per_day;
            reviews_per_day <=> settings_reviews_per_day;
            login_state: settings_login_state;
            login_message: settings_login_message;
            request_text(field) => {
                request_text(field);
            }
            credentials_edited => {
                credentials_edited();
            }
            validate => {
                validate_login();
            }
            save => {
                save_settings();
            }
            cancel => {
                showing_settings = false;
            }
        }

        if error_message == "" && !showing_settings && !learning: DeckSelectScreen {
            new_total: deck_tree.new_total;
            learn_total: deck_tree.learn_total;
            due_total: deck_tree.due_total;
            deck_nodes: deck_tree.deck_nodes;
            syncing: syncing;
            sync_message: sync_message;
            sync_failed: sync_failed;
            sync_choice: sync_choice;
            sync_upload_ok: sync_upload_ok;
            sync_download_ok: sync_download_ok;
            sync_confirm <=> sync_confirm;
            sync_clicked => {
                sync();
            }
            full_sync(upload) => {
                full_sync(upload);
            }
            dismiss_sync => {
                dismiss_sync();
            }
            deck_clicked(deck) => {
                deck_clicked(deck, columns, rows);
                learning = true;
            }
            deck_toggled(deck) => {
                toggle_deck(deck);
            }
            settings_clicked => {
                open_settings();
                showing_settings = true;
            }
        }

        if error_message == "" && !showing_settings && learning: LearnScreen {
            card: current_card;
            paused: editing;
            home_clicked => {
                update_deck_tree();
                learning = false;
            }
            rate(rating) => {
                rate(rating, current_card.deck, columns, rows);
            }
            undo => {
                return undo(current_card.deck, columns, rows);
            }
            suspend => {
                suspend(current_card.deck, columns, rows);
            }
            edit => {
                edit_card();
            }
            init => {
                self.focus();
            }
        }
    }

    if editing: Rectangle {
        background: Constants.paper;

        // Keeps taps away from the study screen underneath
        TouchArea { }

        EditScreen {
            x: Constants.padding;
            y: Constants.padding;
            width: parent.width - 2 * Constants.padding;
            height: parent.height - 2 * Constants.padding;
            native_keyboard: native_keyboard;
            sides: edit_sides;
            error: edit_error;
            side <=> edit_side;
            edit_text(side) => {
                edit_text(side);
            }
            typed(side, text) => {
                edit_typed(side, text);
            }
            save => {
                save_edit(current_card.deck, columns, rows);
            }
            cancel => {
                editing = false;
            }
        }
    }
}
