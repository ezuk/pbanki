import { Count, Deck } from "../components/deck.slint";
import { InkButton } from "../components/ink_button.slint";
import { Constants } from "../constants.slint";
import { DeckNode } from "../types.slint";

component Header {
    in property <int> new_total;
    in property <int> learn_total;
    in property <int> due_total;
    callback settings_clicked();

    VerticalLayout {
        spacing: Constants.spacing;

        HorizontalLayout {
            Text {
                horizontal-stretch: 1;
                text: "pbAnki";
                font-family: Constants.font_family;
                font-size: Constants.font_size_heading;
                font-weight: 800;
                vertical-alignment: center;
            }

            InkButton {
                width: Constants.nav_height * 3.5;
                height: Constants.nav_height;
                text: "Settings";
                font-size: Constants.font_size_small;
                clicked => {
                    settings_clicked();
                }
            }
        }

        HorizontalLayout {
            Text {
                horizontal-stretch: 1;
                text: new_total + learn_total + due_total == 0 ? "No cards are due yet." : "";
                font-family: Constants.font_family;
                font-size: Constants.font_size_small;
                vertical-alignment: bottom;
            }

            for label in ["New", "Learn", "Due"]: Text {
                width: Constants.count_width;
                text: label;
                font-family: Constants.font_family;
                font-size: Constants.font_size_small;
                color: Constants.faded;
                horizontal-alignment: right;
                vertical-alignment: bottom;
            }
        }

        Rectangle {
            height: Constants.border * 2;
            background: Constants.ink;
        }
    }
}

export component DeckSelectScreen {
    in property <int> new_total;
    in property <int> learn_total;
    in property <int> due_total;
    in property <[DeckNode]> deck_nodes;

    callback deck_clicked(deck: DeckNode);
    callback deck_toggled(deck: DeckNode);
    callback settings_clicked();

    VerticalLayout {
        spacing: Constants.spacing;

        Header {
            vertical-stretch: 0;
            new_total: new_total;
            learn_total: learn_total;
            due_total: due_total;
            settings_clicked => {
                settings_clicked();
            }
        }

        Flickable {
            vertical-stretch: 1;
            interactive: true;

            VerticalLayout {
                alignment: start;
                for deck in deck_nodes: Deck {
                deck: deck;
                toggle => {
                    deck_toggled(deck);
                }
                    deck_clicked => {
                        deck_clicked(deck);
                    }
                }
            }
        }
    }
}
