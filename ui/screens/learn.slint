import { Constants } from "../constants.slint";
import { DeckNode, CardNode, Page } from "../types.slint";
import { Count } from "../components/deck.slint";
import { InkButton } from "../components/ink_button.slint";
import { PageView } from "../components/page_view.slint";

component TopBar {
    in property <CardNode> card;
    callback home_clicked();

    height: Constants.top_bar_height;

    HorizontalLayout {
        spacing: Constants.spacing;

        TouchArea {
            width: Constants.top_bar_height;
            clicked => {
                home_clicked();
            }
            Image {
                width: Constants.top_bar_height * 0.7;
                source: @image-url("../icons/home.svg");
            }
        }

        Text {
            horizontal-stretch: 1;
            text: card.deck.name;
            font-family: Constants.font_family;
            font-size: Constants.font_size_content;
            font-weight: 700;
            overflow: elide;
            vertical-alignment: center;
        }

        Count {
            value: card.deck.new;
        }

        Count {
            value: card.deck.learn;
        }

        Count {
            value: card.deck.due;
            bold: true;
        }
    }
}

export component LearnScreen {
    in property <CardNode> card;
    in-out property <bool> show_answer;
    in-out property <bool> show_context;
    property <bool> has_card: card.message == "";
    property <[Page]> pages: show_context ? card.context : show_answer ? card.answer : card.question;
    property <int> current-page: 0;
    property <int> total-pages: pages.length;
    property <bool> on_last_page: current-page >= total-pages - 1;

    callback home_clicked();
    callback rate(rating: int);
    // Undoes the last rating; false if there was nothing to undo
    callback undo() -> bool;
    callback suspend();
    callback open_book();

    function previous_page() {
        if current-page > 0 {
            current-page -= 1;
        }
    }

    function next_page() {
        if current-page < total-pages - 1 {
            current-page += 1;
        }
    }

    function reveal() {
        show_answer = true;
        current-page = Math.min(card.answer_start, card.answer.length - 1);
    }

    function toggle_context() {
        show_context = !show_context;
        current-page = show_context ? 0 : Math.min(card.answer_start, card.answer.length - 1);
    }

    // Shows the card that was just rated again, answer side up
    function undo_rating() {
        if undo() {
            show_context = false;
            reveal();
        }
    }

    function suspend_card() {
        show_answer = false;
        show_context = false;
        current-page = 0;
        suspend();
    }

    function answer(rating: int) {
        show_answer = false;
        show_context = false;
        current-page = 0;
        rate(rating);
    }

    forward-focus: focus-scope;

    focus-scope := FocusScope {
        // Next (Right) moves forward: page, reveal, then Good.
        // Prev (Left) goes back a page, or undoes the last rating on a card's first page.
        key-pressed(event) => {
            let prev = (event.text == Key.LeftArrow) || (event.text == Key.DownArrow) || (event.text == Key.PageDown);
            let next = (event.text == Key.RightArrow) || (event.text == Key.UpArrow) || (event.text == Key.PageUp) || (event.text == Key.Return) || (event.text == Key.Menu);
            if show_context {
                if prev {
                    if current-page > 0 { previous_page(); } else { toggle_context(); }
                    return accept;
                }
                if next {
                    next_page();
                    return accept;
                }
                return reject;
            }
            if prev {
                if current-page > 0 { previous_page(); } else { undo_rating(); }
                return accept;
            }
            if next && has_card {
                if !on_last_page {
                    next_page();
                } else if !show_answer {
                    reveal();
                } else {
                    answer(2);
                }
                return accept;
            }
            reject
        }

        VerticalLayout {
            spacing: Constants.spacing;

            TopBar {
                card: card;
                home_clicked => {
                    home_clicked();
                }
            }

            Rectangle {
                height: Constants.border * 2;
                background: Constants.ink;
            }

            // Card text; tap the left or right third to turn pages
            content := Rectangle {
                vertical-stretch: 1;

                if has_card: PageView {
                    width: 100%;
                    height: 100%;
                    page: current-page < pages.length ? pages[current-page] : { lines: [] };
                    vertically-centered: !show_context;
                }

                if !has_card: Text {
                    width: 100%;
                    text: card.message;
                    font-family: Constants.font_family;
                    font-size: Constants.font_size_content;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                SwipeGestureHandler {
                    handle-swipe-up: current-page < total-pages - 1;
                    handle-swipe-down: current-page > 0;
                    // Right to left undoes the last rating
                    handle-swipe-left: !show_context;
                    swiped => {
                        let dx = self.current-position.x - self.pressed-position.x;
                        let dy = self.current-position.y - self.pressed-position.y;
                        if abs(dx) > abs(dy) {
                            if dx < 0 {
                                undo_rating();
                            }
                        } else if dy < 0 {
                            next_page();
                        } else {
                            previous_page();
                        }
                    }

                    // Front: any tap reveals the answer. Back: a tap turns the page, then rates Good.
                    // Context: the outer thirds turn pages.
                    TouchArea {
                        clicked => {
                            if !has_card {
                                return;
                            }
                            if !show_answer {
                                reveal();
                            } else if !show_context {
                                if on_last_page { answer(2); } else { next_page(); }
                            } else if self.mouse-x < self.width / 3 {
                                previous_page();
                            } else if self.mouse-x > self.width * 2 / 3 {
                                next_page();
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                height: Constants.nav_height;
                spacing: Constants.spacing;

                // Columns mirror the rating buttons: Suspend, indicator, Context
                Rectangle {
                    horizontal-stretch: 1;
                    if has_card && !show_context: InkButton {
                        width: 100%;
                        height: 100%;
                        text: "Suspend";
                        font-size: Constants.font_size_small;
                        clicked => {
                            suspend_card();
                        }
                    }
                }

                Text {
                    horizontal-stretch: 2;
                    text: total-pages > 1 ? (current-page > 0 ? "‹ " : "  ") + (current-page + 1) + "/" + total-pages + (on_last_page ? "  " : " ›") : "";
                    font-family: Constants.font_family;
                    font-size: Constants.font_size_small;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                Rectangle {
                    horizontal-stretch: 1;
                    if has_card && show_answer && !show_context && card.context.length > 0: InkButton {
                        width: 100%;
                        height: 100%;
                        text: "Context";
                        font-size: Constants.font_size_small;
                        clicked => {
                            toggle_context();
                        }
                    }
                }
            }

            HorizontalLayout {
                height: Constants.button_bar_height;
                spacing: Constants.spacing;

                if has_card && !show_answer: InkButton {
                    text: "Show Answer";
                    clicked => {
                        reveal();
                    }
                }

                if has_card && show_context: HorizontalLayout {
                    spacing: Constants.spacing;
                    InkButton {
                        text: "‹ Back";
                        clicked => {
                            toggle_context();
                        }
                    }
                    InkButton {
                        text: "Open in book";
                        enabled: card.can_open_book;
                        clicked => {
                            open_book();
                        }
                    }
                }

                if has_card && show_answer && !show_context: HorizontalLayout {
                    spacing: Constants.spacing;
                    for rating in 4: InkButton {
                        text: ["Again", "Hard", "Good", "Easy"][rating];
                        detail: card.durations[rating];
                        clicked => {
                            answer(rating);
                        }
                    }
                }

                if !has_card: InkButton {
                    text: "‹ Decks";
                    clicked => {
                        home_clicked();
                    }
                }
            }
        }
    }
}
