import { Constants } from "../constants.slint";
import { EditSide } from "../types.slint";
import { InkButton } from "../components/ink_button.slint";

// One side of a card per screen: front, then back, typed on the on-screen keyboard.
export component EditScreen {
    in property <[EditSide]> sides;
    in property <string> error;
    in-out property <int> side;
    property <EditSide> current: side < sides.length ? sides[side] : { title: "", text: "", formatted: false };
    property <bool> is_last: side >= sides.length - 1;
    // Anki needs a front
    property <bool> front_filled: sides.length > 0 && sides[0].text != "";

    callback typed(side: int, text: string);
    callback save();
    callback cancel();

    property <length> line_height: lines.preferred-height / 100;

    // Puts the side's text in the box with the cursor at the end
    function load() {
        input.text = current.text;
        input.set-selection-offsets(current.text.character-count * 4, current.text.character-count * 4);
        flick.viewport-y = 0;
        input.focus();
    }

    init => {
        load();
    }

    changed side => {
        load();
    }

    // Measures 100 lines of the text below; one alone is rounded to a whole pixel
    lines := Text {
        visible: false;
        width: 0;
        height: 0;
        text: "\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n";
        font-family: Constants.font_family;
        font-size: Constants.font_size_content;
    }

    VerticalLayout {
        spacing: Constants.spacing;

        HorizontalLayout {
            height: Constants.top_bar_height;

            Text {
                horizontal-stretch: 1;
                text: "Edit card";
                font-family: Constants.font_family;
                font-size: Constants.font_size_content;
                font-weight: 700;
                color: Constants.ink;
                vertical-alignment: center;
            }

            if sides.length > 1: Text {
                text: (side + 1) + " of " + sides.length;
                font-family: Constants.font_family;
                font-size: Constants.font_size_small;
                color: Constants.faded;
                vertical-alignment: center;
            }
        }

        Rectangle {
            height: Constants.border * 2;
            background: Constants.ink;
        }

        Text {
            text: current.title;
            font-family: Constants.font_family;
            font-size: Constants.font_size_small;
            font-weight: 700;
            color: Constants.faded;
        }

        Rectangle {
            vertical-stretch: 1;
            border-width: Constants.border;
            border-color: Constants.ink;
            border-radius: Constants.radius;
            clip: true;

            Rectangle {
                x: Constants.spacing;
                y: Constants.spacing;
                width: parent.width - 2 * Constants.spacing;
                height: parent.height - 2 * Constants.spacing;
                clip: true;

            flick := Flickable {
                viewport-height: input.height;

                input := TextInput {
                    width: flick.width;
                    // A spare line keeps letter tails in view and lets it scroll to a line boundary
                    height: Math.max(flick.height, self.preferred-height + root.line_height);
                    font-family: Constants.font_family;
                    font-size: Constants.font_size_content;
                    color: Constants.ink;
                    selection-background-color: Constants.shade;
                    selection-foreground-color: Constants.ink;
                    text-cursor-width: Constants.hairline * 2;
                    single-line: false;
                    wrap: word-wrap;
                    edited => {
                        root.typed(root.side, self.text);
                    }
                    // Scrolls by whole lines to keep the cursor in view
                    cursor-position-changed(pos) => {
                        if pos.y + flick.viewport-y < 0 {
                            flick.viewport-y = -pos.y;
                        } else if pos.y + line_height + flick.viewport-y > flick.height {
                            flick.viewport-y = Math.floor(flick.height / line_height) * line_height - pos.y - line_height;
                        }
                    }
                }
            }
            }
        }

        if error != "" || current.formatted: Text {
            text: error != "" ? error : "Changing this side removes its formatting, such as bold or images.";
            font-family: Constants.font_family;
            font-size: Constants.font_size_small;
            font-weight: error != "" ? 700 : 400;
            color: error != "" ? Constants.ink : Constants.faded;
            wrap: word-wrap;
        }

        HorizontalLayout {
            height: Constants.button_bar_height;
            spacing: Constants.spacing;

            InkButton {
                text: side > 0 ? "‹ " + sides[side - 1].title : "Cancel";
                clicked => {
                    if side > 0 {
                        side -= 1;
                    } else {
                        cancel();
                    }
                }
            }

            InkButton {
                text: is_last ? "Save" : sides[side + 1].title + " ›";
                enabled: front_filled;
                clicked => {
                    if is_last {
                        save();
                    } else {
                        side += 1;
                    }
                }
            }
        }
    }
}
